# Required: OpenRouter API key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: override default model (default: google/gemini-2.5-flash)
# Any model on OpenRouter works: google/gemini-2.5-flash, anthropic/claude-sonnet-4, openai/gpt-4o, etc.
# Full list: https://openrouter.ai/models
# JOURNAL_MODEL=google/gemini-2.5-flash

# Optional: override database path (default: ./data/journal.db)
# DATABASE_PATH=./data/journal.db
